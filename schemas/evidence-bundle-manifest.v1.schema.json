{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/edge-evidence/evidence-bundle-manifest.v1.schema.json",
  "title": "Operational Evidence Bundle Manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "bundle_version", "artifacts"],
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_version": {"const": "1.0"},
    "artifacts": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bytes", "media_type", "sha256"],
        "properties": {
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
